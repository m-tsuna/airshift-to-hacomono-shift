{
  "manifest_version": 3,
  "name": "シフト自動入力（Airシフト → hacomono）",
  "version": "1.0.0",
  "description": "Airシフトの CSV を、hacomono のシフト表に自動で入力します。データはパソコンの外に送りません。",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://*.hacomono.jp/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "シフト自動入力を開く", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "content_scripts": [
    { "matches": ["https://*.hacomono.jp/*"], "js": ["content.js"] }
  ]
}
